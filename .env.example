# Host-side variables.
#
# THIS FILE IS AN EXAMPLE. Copy it to .env and fill it in locally.
# .env is in .gitignore and must never be committed.
#
# Secrets belong here, not in components/bot_config/include/bot_config.h. A value written in a
# header is compiled into the firmware image AND committed to Git, which
# violates the Discord Developer Terms.

# --- Discord application -------------------------------------------------
# Public ID. Safe to expose, still keep it out of Git.
DC_APP_ID=

# Bot token. NEVER commit this. Loaded into encrypted NVS on first boot.
DC_BOT_TOKEN=

# Guild the bot is scoped to. Optional, enables instant command registration.
DC_GUILD_ID=

# --- Wi-Fi ----------------------------------------------------------------
DC_WIFI_SSID=
DC_WIFI_PASSWORD=

# --- Provisioning ---------------------------------------------------------
# Printed on the serial console at first boot. Read once, then stored in NVS.
DC_PROVISION_TIMEOUT_SEC=120

# --- Build ----------------------------------------------------------------
# ESP-IDF toolchain and target
IDF_TARGET=esp32
IDF_PARTITION_TABLE=single_app_large.csv

# Serial port for flashing. macOS example: /dev/cu.usbserial-0001
DC_FLASH_PORT=

# --- Feature flags consumed by the builder --------------------------------
# These select code at compile time. Unused features are removed by the linker.
DC_FEATURE_RANKS=1
DC_FEATURE_TICKETS=1
DC_FEATURE_CAPTCHA=1
# Requires the MESSAGE_CONTENT privileged intent in the Developer Portal.
DC_FEATURE_SPAM=0

# --- Logging ---------------------------------------------------------------
# 0 quiet, 1 normal, 2 debug
DC_LOG_LEVEL=1
# REST transport rides esp_https_client, which is off by default.
CONFIG_ESP_HTTPS_CLIENT_ENABLE=y
# Dynamic TLS buffers save about 20 KB of DRAM. Mutually exclusive with
# TLS 1.3, so CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 stays off and the link
# negotiates TLS 1.2.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# AES and SHA run in hardware, which the WROOM-32D has.
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
# mbedTLS 4.1.0 is the TLS library behind esp_tls; wolfSSL is not used.
CONFIG_ESP_TLS_USING_MBEDTLS=y
# The default is 10 static RX buffers; six still covers the gateway
# traffic and frees DRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# lwIP runs its TCP/IP thread at 18. No application task may run at or
# above it: ack 16, gateway 15, rest 12, bot 10, monitor 10.
CONFIG_LWIP_TCPIP_TASK_PRIO=18
# 1 ms tick resolution, matching the millisecond budgets the transport
# is measured in.
CONFIG_FREERTOS_HZ=1000
# Main task stack: app_main wires NVS, the event loop, Wi-Fi and the
# five transport tasks before returning.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# The plan's custom table below replaces the built-in single_app_large.
# The file lives at this example's project root; ESP-IDF resolves
# the path from the project root, so no directory prefix is needed.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
